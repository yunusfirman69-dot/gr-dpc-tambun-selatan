{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gr-dpc-tambun-selatan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_CONVEX_URL": "https://accurate-gull-945.convex.cloud"
  },
  "observability": {
    "enabled": true
  }
}